{
  "name": "video",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "The CrackPay marketing film. Scenes are React, so the brand tokens and the brand mark are the same ones the product ships.",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "studio": "remotion studio",
    "render": "pnpm run render:vertical && pnpm run render:landscape",
    "render:vertical": "remotion render Vertical out/crackpay-30s-9x16.mp4",
    "render:landscape": "remotion render Landscape out/crackpay-30s-16x9.mp4",
    "still": "remotion still Poster out/crackpay-poster.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crackpay/brand": "workspace:*",
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/media": "4.0.533",
    "@remotion/tailwind-v4": "4.0.533",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
