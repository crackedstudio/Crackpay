# Copy to .env.local and fill in. Never commit real values.
# Anything prefixed NEXT_PUBLIC_ ships to the browser — no secrets behind that prefix.

# --- Circle ---
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
NEXT_PUBLIC_CIRCLE_CLIENT_URL=
CIRCLE_API_KEY=

# --- Arc ---
# "mainnet" (real USDC, chain 5042) or "testnet" (default, chain 5042002). One per deployment:
# mainnet and testnet each need their own Circle client key, Gas Station policy,
# Supabase project and passkey domain.
NEXT_PUBLIC_ARC_NETWORK=
NEXT_PUBLIC_ARC_CHAIN_ID=
NEXT_PUBLIC_ARC_RPC_URL=
ARC_WS_URL=

# --- Contracts (fill after deploy) ---
NEXT_PUBLIC_IDENTITY_REGISTRY=
NEXT_PUBLIC_CASH_LINK=
NEXT_PUBLIC_PAYMENT_ROUTER=

# --- Onboarding ---
# "phone" (default) or "passkey". See src/config/onboarding.ts.
NEXT_PUBLIC_ONBOARDING_MODE=

# --- Mini Apps ---
NEXT_PUBLIC_MINIAPP_KASHLINK_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (session pooler). Only used to push migrations; the app never reads it.
SUPABASE_DB_URL=

# --- Secrets (server only) ---
PHONE_HASH_PEPPER=
SESSION_SECRET=
ATTESTATION_SIGNER_KEY=
# Twilio Verify sends and checks sign-in codes. All three are needed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Admin (/admin) ---
# At least 16 characters.
ADMIN_PASSWORD=
