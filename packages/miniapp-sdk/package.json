{
  "name": "@crackpay/miniapp-sdk",
  "version": "0.1.0",
  "description": "Build Mini Apps that run inside CrackPay, the USD stablecoin wallet on Arc.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./viem": { "types": "./dist/viem.d.ts", "import": "./dist/viem.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "viem": ">=2.21"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "viem": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.2.8",
    "typescript": "^5",
    "viem": "2.55.11",
    "vitest": "^5.0.3"
  },
  "keywords": ["crackpay", "arc", "usdc", "mini-app", "eip-1193", "wallet"],
  "homepage": "https://crackpay.vercel.app/developers",
  "publishConfig": { "access": "public" }
}
