# Copy to .env.local and fill in. Never commit real values.
# The marketing site is static and public: it has no secrets of its own.

# Origin of the wallet app, with no trailing slash. Defaults to
# https://crackpay.xyz; set it to http://localhost:3000 for local work. This
# site has no passkey of its own; the app's domain is the one credentials bind
# to, and it cannot change once real users exist — see "Passkey constraint" in
# CLAUDE.md.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origin of this site, used for canonical and share metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# "passkey" (default) or "phone". Must match the wallet app's setting, so the
# "I already have an account" link opens the right door. CrackPay verifies no
# phone number today, so the default is "passkey" and the app's own
# NEXT_PUBLIC_ONBOARDING_MODE is left unset or set to "passkey".
NEXT_PUBLIC_ONBOARDING_MODE=

# Origin of the developer documentation, with no trailing slash. Defaults to
# https://docs.crackpay.xyz, so only set this to point at a preview build.
NEXT_PUBLIC_DOCS_URL=
